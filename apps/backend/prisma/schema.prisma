// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  // Prisma 7's modern generator. The client is written into src/ as ordinary
  // generated source instead of being injected into node_modules, so it
  // survives dependency pruning and multi-stage Docker copies.
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  admin

  @@map("user_role")
}

enum QuackMood {
  happy
  sad
  angry
  silly

  @@map("quack_mood")
}

// A quack that starts a conversation, or a reply (parentId set). Deleting one
// that has replies leaves an empty placeholder: see docs/adr/0002. Every
// column is either content (cleared on a placeholder, and listed in the
// quack_placeholder_empty_check constraint) or position (kept).
model Quack {
  id        String     @id @default(cuid())
  // Content. null only on a placeholder.
  text      String?    @db.Text
  // Content.
  mood      QuackMood?
  // Content. null on a placeholder. SetNull: removing a user must never
  // cascade through other people's replies.
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt
  // Content: deleted when a placeholder is made.
  poll      Poll?
  // Content. Derived from `text` when the quack is posted (lowercase, each
  // once); see extractHashtags and docs/adr/0001. Cleared together with text.
  hashtags  String[]   @default([])
  // Set when the content was cleared. The row lives only while something
  // still replies to it; the delete removes it as soon as nothing does.
  deletedAt DateTime?

  // The quack this one answers; null for a quack that starts a conversation.
  // Restrict: the database refuses a hard delete that would take replies with it.
  parent   Quack?  @relation("QuackReplies", fields: [parentId], references: [id], onDelete: Restrict)
  parentId String?
  replies  Quack[] @relation("QuackReplies")

  // The quack that started the conversation. Written once when the reply is
  // posted (parent.rootId ?? parent.id) and never changed, because replies are
  // never moved, so a whole conversation is one indexed query.
  root   Quack?  @relation("QuackThread", fields: [rootId], references: [id], onDelete: Restrict)
  rootId String?
  thread Quack[] @relation("QuackThread")

  @@index([userId])
  @@index([hashtags], type: Gin)
  @@index([parentId])
  @@index([rootId, createdAt])
  @@map("quack")
}

model Poll {
  id        String       @id @default(cuid())
  quack     Quack        @relation(fields: [quackId], references: [id], onDelete: Cascade)
  quackId   String       @unique
  // null while open; set once by the author and never cleared.
  closedAt  DateTime?
  createdAt DateTime     @default(now())
  options   PollOption[]
  votes     PollVote[]

  @@map("poll")
}

model PollOption {
  id       String     @id @default(cuid())
  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  pollId   String
  text     String     @db.VarChar(50)
  // The order the author wrote the answers in; votes never reorder them.
  position Int
  votes    PollVote[]

  @@unique([pollId, position])
  // Lets a vote point at (option, poll) together, see PollVote.option.
  @@unique([id, pollId])
  @@map("poll_option")
}

// One row per voter per poll. Counts are always derived from these rows,
// never stored, so they can't drift.
model PollVote {
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  pollId    String
  // Composite so the database refuses a vote for another poll's answer.
  option    PollOption @relation(fields: [optionId, pollId], references: [id, pollId], onDelete: Cascade)
  optionId  String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  updatedAt DateTime   @updatedAt

  // One person, one vote — enforced by the database.
  @@id([pollId, userId])
  @@index([optionId])
  @@map("poll_vote")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @db.VarChar(255)
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  issuer                String?
  password              String?   @db.Text
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model User {
  id            String     @id
  name          String
  email         String
  emailVerified Boolean
  image         String?    @db.Text
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  quacks        Quack[]
  pollVotes     PollVote[]
  role          UserRole   @default(user)

  username        String? @db.VarChar(50)
  displayUsername String? @db.VarChar(50)

  bio              String?    @db.VarChar(160)
  // Preselected in the new-quack form; null means "no mood".
  defaultQuackMood QuackMood?

  @@unique([email])
  @@unique([username])
  @@map("user")
}
